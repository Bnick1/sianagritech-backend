{
  "name": "sianagritech-backend",
  "version": "1.0.0",
  "description": "SianAgriTech - Agricultural platform for small-scale farmers",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "minimal": "node server-minimal.js",
    "build": "npm install",
    "prod": "cross-env NODE_ENV=production node server.js",
    "prod:win": "cross-env NODE_ENV=production node server.js",
    "test": "node test-health.js",
    "test:health": "node test-health.js",
    "test:sync": "node test-sync.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf node_modules package-lock.json",
    "clean:win": "rmdir /s /q node_modules && del package-lock.json",
    "reinstall": "npm run clean && npm install",
    "reinstall:win": "npm run clean:win && npm install",
    "health": "node -e \"console.log('Node Version:', process.version); console.log('Platform:', process.platform); console.log('NODE_ENV:', process.env.NODE_ENV || 'not set');\"",
    "fix:deps": "node scripts/fix-deps.js",
    "reset": "npm run clean && npm cache clean --force && npm install",
    "doctor": "node scripts/doctor.js"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.10.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "redis": "^4.6.12",
    "sequelize": "^6.35.0",
    "sharp": "^0.33.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "agriculture",
    "iot",
    "smart-farming",
    "africa",
    "api",
    "sianagritech"
  ],
  "author": "SianAgriTech Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sianagritech/backend"
  },
  "bugs": {
    "url": "https://github.com/sianagritech/backend/issues"
  },
  "homepage": "https://sianagritech.com"
}