// ERROR HANDLING
// ============================================================
app.use((req, res) => {
    res.status(404).json({
        success: false,
        error: 'Route not found: ' + req.originalUrl
    });
});

app.use((err, req, res, next) => {
    console.error('Error:', err);
    res.status(500).json({ success: false, error: 'Internal server error' });
});

